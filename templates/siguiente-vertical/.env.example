# ══════════════════════════════════════════════════════════════════════════════
# apps/__VERTICAL__ — Variables de Entorno
# Reemplaza __VERTICAL__ por el nombre real (ej: creditos, fumigacion).
# Copia como .env.local y rellena los valores reales.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase __VERTICAL_TITULO__ ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Multi-Zone (URL de apps/barberia — zona raíz del dominio) ─────────────────
WEB_ZONE_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3002
