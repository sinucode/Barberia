# ══════════════════════════════════════════════════════════════════════════════
# Xinuco OS — Variables de Entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commitees .env.local al repositorio.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=

# ── Stripe (RF23 — SaaS Billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# IDs de precios en Stripe (crear en dashboard.stripe.com → Products)
STRIPE_PRICE_BASICO=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# ── WhatsApp Cloud API (RF18 — Notificaciones) ────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Resend (RF18 — Email + recordatorios automáticos) ────────────────────────
RESEND_API_KEY=re_...

# ── Cron Jobs (RF18 — Recordatorios automáticos) ─────────────────────────────
# Vercel añade este header automáticamente al llamar /api/cron/*
# Generar con: openssl rand -hex 32
CRON_SECRET=

# ── hCaptcha (Protección contra bots en login) ───────────────────────────────
# Obtener en: https://dashboard.hcaptcha.com → Sites
# Site Key: va aquí (expuesta al browser, no es secreta)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=d46cd594-50ae-43d8-8912-4356fed48d1a
# Secret Key: va en Supabase Dashboard → Auth → Attack Protection → Captcha secret
# (NO se pone en el código ni en Vercel — solo en Supabase)

# ── MercadoPago (RF-MP — Pagos LATAM) ────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.co/developers/panel/app
# Credentials → Access Token (producción) / Test Access Token (sandbox)
MP_ACCESS_TOKEN=APP_USR-...
# App ID (Panel MP → Tus aplicaciones → App ID)
MP_APP_ID=
# Secret HMAC para verificar webhooks (Panel MP → Tu negocio → Webhooks)
# Dejar vacío al desplegar; completar después de crear el webhook en MP
MP_WEBHOOK_SECRET=
